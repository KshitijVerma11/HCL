# ==============================================================================
# Road Accident Risk Prediction Platform - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# Never commit .env files containing production secrets.
# ==============================================================================

# Application Port
PORT=8000

# Docker Compose Host Port Mapping
HOST_PORT=8000

# Node.js Environment (development | production | test)
NODE_ENV=production

# Trusted Cross-Origin Resource Sharing (CORS) Origins
# Comma-separated list of authorized origins (scheme + host + optional port)
# Example: https://roadsafety.example.com,https://staging.roadsafety.example.com
# Same-origin requests matching the Host header are always allowed by default.
ALLOWED_ORIGINS=

# API Rate Limiting Configuration
# Window size in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per client IP within the window (default: 120)
# Set higher if legitimate clients send rapid batch telemetry
RATE_LIMIT_MAX=120

# Optional CARTO / Mapbox Basemap API Key
# If set, tile requests automatically append ?api_key=<CARTO_API_KEY>
# Leave blank to use CARTO's free public basemaps without credentials
CARTO_API_KEY=cb1_4wgx_1_123791af9fa37e303a9dfbff

# Optional Custom Map Tile URL
# Overrides default basemap URL (default: CARTO Dark Matter)
# Example: https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=cb1_4wgx_1_123791af9fa37e303a9dfbff

